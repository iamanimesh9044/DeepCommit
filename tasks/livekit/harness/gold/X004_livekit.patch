diff --git a/pkg/sfu/flexfec/decoder.go b/pkg/sfu/flexfec/decoder.go
new file mode 100644
index 00000000..11427f2f
--- /dev/null
+++ b/pkg/sfu/flexfec/decoder.go
@@ -0,0 +1,524 @@
+// Copyright 2026 LiveKit, Inc.
