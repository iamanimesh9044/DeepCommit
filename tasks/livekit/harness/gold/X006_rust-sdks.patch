+components:
+  schemas:
+    cloud_protocol.PIIRedactionCategory:
+      type: string
+      title: PIIRedactionCategory
+      enum:
+        - PII_REDACTION_CATEGORY_UNSPECIFIED
+        - PII_REDACTION_CATEGORY_ACCOUNT_NUMBER
+        - PII_REDACTION_CATEGORY_AGE
