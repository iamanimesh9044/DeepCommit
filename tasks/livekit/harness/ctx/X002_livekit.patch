diff --git a/test/signal_message_size_limit_test.go b/test/signal_message_size_limit_test.go
new file mode 100644
index 00000000..80ef7fd9
--- /dev/null
+++ b/test/signal_message_size_limit_test.go
@@ -0,0 +1,223 @@
+// Copyright 2026 LiveKit, Inc.
+//
