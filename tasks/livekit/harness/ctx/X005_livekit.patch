+				}
+			}
+			at = at.Add(tc.last.duration)
+			q.UpdateAt(tc.last, at)
+
+			require.Equal(t, tc.mode, int(float64(q.ppsMode)*cPPSQuantization))
+			_, quality := q.GetScoreAndQuality()
+			require.Equal(t, tc.quality, quality)
+		})
+	}
