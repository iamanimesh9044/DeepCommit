+			lock.Lock()
+			defer lock.Unlock()
+			if subscribed {
+				return nil, errAlreadySubscribed
+			}
+			subscribed = true
+			st := &typesfakes.FakeSubscribedTrack{}
+			st.IDReturns("track")
+			st.MediaTrackReturns(mt)
+			return st, nil
+		})
