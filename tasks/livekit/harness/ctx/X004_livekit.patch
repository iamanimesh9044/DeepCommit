+
+func TestNullFollowsTarget(t *testing.T) {
+	n := NewNull()
+
+	// a switch key frame on temporal layer 0 reaches a higher target right away
+	this, next := n.Select(nil, 0, 2)
+	require.Equal(t, int32(2), this)
