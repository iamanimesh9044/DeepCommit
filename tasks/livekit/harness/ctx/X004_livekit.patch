+func (f *Forwarder) setSimulcastSelector() {
+	if f.vls == nil {
+		f.vls = videolayerselector.NewSimulcast(f.logger)
+		return
+	}
+	if vls := videolayerselector.NewSimulcastFromOther(f.vls); vls != nil {
