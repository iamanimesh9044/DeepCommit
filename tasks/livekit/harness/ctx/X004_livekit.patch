+				return
+			}
+			require.NoError(t, err)
+			require.Equal(t, tc.wantUser, conf.RTC.TURNServers[0].Username)
+			require.Equal(t, tc.wantCredential, conf.RTC.TURNServers[0].Credential)
+		})
+	}
+}
