+// RedactUrlQueryValues fully redacts every query parameter value in rawUrl, keeping parameter names intact.
+func RedactUrlQueryValues(rawUrl string) string {
+	base, query, found := strings.Cut(rawUrl, "?")
+	if !found || query == "" {
+		return rawUrl
+	}
+
