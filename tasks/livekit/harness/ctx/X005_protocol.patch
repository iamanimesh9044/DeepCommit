+		Reason:     SIPTransferReason_STR_REJECTED,
+		SipStatus:  sipStatus,
+	}
+	// One detail carries the whole outcome, SIP status included.
+	err := psrpc.NewError(psrpc.UpstreamClientError, errors.New("call transfer failed"), transferErr)
