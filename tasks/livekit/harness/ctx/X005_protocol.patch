+func captureStderr(tb testing.TB) func() string {
+	tb.Helper()
+	f, err := os.CreateTemp(tb.TempDir(), "stderr")
+	require.NoError(tb, err)
+	prev := os.Stderr
+	os.Stderr = f
+	tb.Cleanup(func() {
+		os.Stderr = prev
+		f.Close()
+	})
+	return func() string {
+		b, err := os.ReadFile(f.Name())
+		require.NoError(tb, err)
+		return string(b)
+	}
