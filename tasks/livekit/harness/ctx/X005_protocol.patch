+func TestSIPTransferErrorFrom(t *testing.T) {
+	sipStatus := &SIPStatus{
+		Code:   SIPStatusCode_SIP_STATUS_BUSY_HERE,
+		Status: "Busy Here",
+	}
+	transferErr := &SIPTransferError{
