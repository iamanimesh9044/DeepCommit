+func silenceStderr(tb testing.TB) {
+	tb.Helper()
+	f, err := os.OpenFile(os.DevNull, os.O_WRONLY, 0)
+	require.NoError(tb, err)
+	prev := os.Stderr
+	os.Stderr = f
+	tb.Cleanup(func() {
+		os.Stderr = prev
+		f.Close()
+	})
+}
