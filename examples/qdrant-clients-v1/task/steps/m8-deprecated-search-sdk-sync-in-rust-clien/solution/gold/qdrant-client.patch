+            collection_name=collection_name,
+            points_selector=list(points),
+            wait=wait,
+            timeout=timeout,
+        )
+
+    async def batch_update_points(
+        self,
+        collection_name: str,
+        update_operations: Sequence[types.UpdateOperation],
+        wait: bool = False,
