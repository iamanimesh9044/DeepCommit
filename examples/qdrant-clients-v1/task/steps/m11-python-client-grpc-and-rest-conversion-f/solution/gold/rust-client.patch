+
+    #[test]
+    fn test_integer_into_float() {
+        // Whole numbers are stored as integers, e.g. `{"price": 10}`
+        let payload = make_payload(json!({
+            "double": 10,
+            "single": -3,
+            "opt_double": 7,
+        }));
+
+        #[derive(Deserialize, Debug, PartialEq)]
+        struct Dst {
+            double: f64,
+            single: f32,
+            opt_double: Option<f64>,
+        }
+
+        let dst: Dst = payload.deserialize().unwrap();
+        assert_eq!(
+            dst,
+            Dst {
+                double: 10.0,
+                single: -3.0,
+                opt_double: Some(7.0),
+            }
+        );
+    }
