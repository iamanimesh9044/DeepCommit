# Base state (state_0) of csf-qdrant-clients-v1-001: 3 repos checked out at their start commits under /app/<repo>.
#
# SKELETON generated by DeepCommit (`workspace export-task`). Not built yet. Fill in the TODOs, build once, then run the
# gates (oracle must score 1 on every step, NOP must score 0). The task has no network at run time, so every dependency
# the tests need must be fetched here.
FROM ubuntu:24.04

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates curl build-essential pkg-config libssl-dev \
      python3 python3-venv python3-dev protobuf-compiler jq xz-utils \
 && rm -rf /var/lib/apt/lists/* \
 && git config --global --add safe.directory '*'

# Rust toolchain (shared CARGO_HOME so the verifier container and the agent container see the same crates).
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:/opt/venv/bin:$PATH
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable

# Python environment for qdrant-client (deps of the newest release, a superset of every step's).
RUN python3 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir 'httpx[http2]' numpy 'pydantic>=2.4' grpcio grpcio-tools 'protobuf>=5' \
      urllib3 portalocker pytest pytest-asyncio pytest-timeout pytest-mock coverage

# Everything the build needs from outside is vendored in vendor/ (pinned commits and the server release), so the task
# still builds if the upstream repositories or release assets are deleted. Only the package registries are reached.
# They are bind-mounted per step, so they add nothing to the image layers.

# A real Qdrant server, for the clients' remote-mode tests. Started by the verifier; never part of a step's change.
RUN --mount=type=bind,source=vendor,target=/tmp/vendor \
    tar -xzf "/tmp/vendor/qdrant-$(uname -m)-unknown-linux-musl.tar.gz" -C /usr/local/bin qdrant \
 && qdrant --version

# The three repositories at their base commits (git archive of the pinned tree; qdrant holds only its contract files).
RUN --mount=type=bind,source=vendor,target=/tmp/vendor \
    for repo in qdrant rust-client qdrant-client; do \
      mkdir -p /app/$repo && tar -xzf /tmp/vendor/$repo.tar.gz -C /app/$repo \
      && git -C /app/$repo init -q && git -C /app/$repo add -A \
      && git -C /app/$repo -c user.name=csf -c user.email=csf@localhost commit -q -m vendored; \
    done

# Prefetch the crates of the base state and of the newest release, so no step needs the network.
RUN --mount=type=bind,source=vendor,target=/tmp/vendor \
    cd /app/rust-client && cargo fetch \
 && mkdir /tmp/rc-final && tar -xzf /tmp/vendor/rust-client-v1.20.0.tar.gz -C /tmp/rc-final \
 && cd /tmp/rc-final && cargo fetch && rm -rf /tmp/rc-final

# qdrant is contract-only: keep just the files matching its contract paths.
RUN cd /app/qdrant \
 && git ls-files -z -- ':(glob)lib/api/src/grpc/proto/**/*.proto' | sort -z > /tmp/keep.txt \
 && git ls-files -z | sort -z > /tmp/all.txt \
 && comm -z -23 /tmp/all.txt /tmp/keep.txt | xargs -0 -r rm -f \
 && find . -type d -empty -not -path './.git/*' -delete \
 && rm -f /tmp/keep.txt /tmp/all.txt

# Background commits (history that no step owns) are part of the base state. The patch is bind-mounted for this one
# step, so it never lands in an image layer the agent could read.
RUN --mount=type=bind,source=base.patch,target=/tmp/csf/base.patch \
    cd /app && git apply --whitespace=nowarn /tmp/csf/base.patch

# A fresh one-commit repository of each base tree, with no upstream history. /app/<repo>/.git is the agent's to use; the
# copy in /opt/csf/base is the grader's fixed reference for csf-collect.
RUN mkdir -p /opt/csf/base \
 && for repo in qdrant rust-client qdrant-client; do \
      cd /app/"$repo" \
      && rm -rf .git \
      && git init -q \
      && git add -A \
      && git -c user.name=csf -c user.email=csf@localhost commit -q -m base \
      && cp -a .git /opt/csf/base/"$repo".git; \
    done

# qdrant-client reads its own installed version at import time: install it editable (metadata only, code stays in /app).
RUN /opt/venv/bin/pip install --no-cache-dir --no-deps -e /app/qdrant-client

# The clients' congruence tests compare local mode with a server on random data: retry a failed test twice before it counts.
RUN /opt/venv/bin/pip install --no-cache-dir pytest-rerunfailures

COPY csf-collect /usr/local/bin/csf-collect
