cff-version: 1.2.0
title: DeepCommit
message: "If you use this software, please cite the paper below (preferred-citation)."
type: software
# Software authors = the code contributors. The full paper author list is under
# preferred-citation. Add more contributors here as the project grows.
authors:
  - given-names: Gangda
    family-names: Deng
    email: gangdade@usc.edu
    affiliation: University of Southern California
  - given-names: Zhaoling
    family-names: Chen
    email: zhaolingc00@gmail.com
repository-code: "https://github.com/DeepCommit-ai/DeepCommit"
abstract: >-
  DeepCommit is an automated agentic pipeline for reconstructing verifiable software
  evolution itineraries from raw git commit histories. It powers the EvoClaw benchmark
  for evaluating AI agents on continuous software evolution.
keywords:
  - git
  - software-evolution
  - commit-history
  - benchmark
  - agentic-pipeline
  - ai-agents
license: Apache-2.0
version: "0.1.0"
