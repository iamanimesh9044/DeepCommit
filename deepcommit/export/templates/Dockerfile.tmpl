# main: the agent's container, and main in every step's grading stack (the test runner and its packages).
# Base state of $task_id: $repo_count repos under /app/<repo>, from app/ (each repo's start commit plus the background
# commits no step owns; contract-only repos pruned to their contract files)$services_note.
#
# Grading builds this image again from this folder; Harbor then empties /app and uploads the agent's /app over it.
# The task has no network at run time, so every dependency the tests need must be fetched here.
# Generated by DeepCommit (`workspace export-task`); toolchains and dependency setup come from the workspace manifest's
# `csf_environment` (TODO markers below when it has none).
FROM ubuntu:24.04

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates curl build-essential pkg-config $apt_packages \
 && rm -rf /var/lib/apt/lists/* \
 && git config --global --add safe.directory '*'

$toolchains_block

# Starting code: one folder per repository$app_services_note.
COPY app/ /app/

$after_app_block

# A one-commit repository of each base tree. /app/<repo>/.git is the agent's to use; the copy in /opt/csf/base is the
# grader's fixed reference: test.sh resets each repo's test dirs to it before the step's checks go in.
RUN mkdir -p /opt/csf/base \
 && for repo in $repo_names; do \
      cd /app/"$$repo" \
      && git init -q \
      && git add -A \
      && git -c user.name=csf -c user.email=csf@localhost commit -q -m base \
      && cp -a .git /opt/csf/base/"$$repo".git; \
    done

WORKDIR /app
