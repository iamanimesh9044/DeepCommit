# Base state (state_0) of $task_id: $repo_count repos checked out at their start commits under /app/<repo>.
#
# SKELETON generated by DeepCommit (`workspace export-task`). Not built yet. Fill in the TODOs, build once, then run the
# gates (oracle must score 1 on every step, NOP must score 0). The task has no network at run time, so every dependency
# the tests need must be fetched here.
FROM ubuntu:24.04

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates curl build-essential pkg-config python3 python3-pip \
 && rm -rf /var/lib/apt/lists/* \
 && git config --global --add safe.directory '*'

# TODO toolchains for: $languages (e.g. rustup + cargo for rust, python3 + pytest for python, go).

$clone_block

# TODO prefetch dependencies and warm the build per repo (cargo fetch/build --tests, pip install -e '.[dev]', go mod download).

$base_patch_block
# A fresh one-commit repository of each base tree, with no upstream history. /app/<repo>/.git is the agent's to use; the
# copy in /opt/csf/base is the grader's fixed reference for csf-collect.
RUN mkdir -p /opt/csf/base \
 && for repo in $repo_names; do \
      cd /app/"$$repo" \
      && rm -rf .git \
      && git init -q \
      && git add -A \
      && git -c user.name=csf -c user.email=csf@localhost commit -q -m base \
      && cp -a .git /opt/csf/base/"$$repo".git; \
    done

COPY csf-collect /usr/local/bin/csf-collect
