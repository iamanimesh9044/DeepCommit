  "milestone_id": "{{ m_id }}",
  "schema_version": 2,
  "based_on_waivers": "schema_version=3",
  "commit_moves": [
    {
      "id": 1,
      "status": "verified",
      "resolving_commit": "f333e3513e8b08fae1e6f64eb1ff7c2d553ed81b",
      "applied_at": "predecessor",
      "conflict_during_pick": "resolved_theirs",
      "resolves": {
        "bound_waiver_ids": [2, 7],
        "unbound_issue_ids": []
      },
      "verified_via_anchor": "tests/admin_views/test_actions.py::AdminActionsTest::test_x"
    },
    {
      "id": 2,
      "status": "pending",
      "resolving_commit": "c7fc9f20b49b5889a9a8f47de45165ac443c1a21",
      "intended_symbol": "login_not_required",
      "intended_path": "django/contrib/auth/decorators.py",
      "discovered_at_attempt": 2,
      "estimated_cluster_error_count": 15
    },
    {
      "id": 3,
      "status": "attempted_failed",
      "resolving_commit": "abc1234567890abcdef1234567890abcdef12345",
      "attempt_log": "Cherry-pick conflicts on django/X.py line 100 unresolvable; --theirs broke 5 unrelated tests; abandoned. Cluster moved to unbound_issues[id=4].",
      "moved_to_unbound_issue_id": 4
    }
  ],
  "dockerfile_diff": "--- a/Dockerfile\n+++ b/Dockerfile\n@@ -42,6 +42,9 @@\n+\n+# [ENV-PATCH] companion shim for cherry-pick f333e3513e8\n+RUN echo 'Field.db_default = None' >> /tmp/sitecustomize.py\n",
